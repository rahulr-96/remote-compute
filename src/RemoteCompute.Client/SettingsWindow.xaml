<Window x:Class="RemoteCompute.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection settings" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <Label Content="Lenovo SSH _username" Target="{Binding ElementName=RelayUser}" />
    <TextBox x:Name="RelayUser" MinHeight="26" Margin="0,0,0,8" />
    <Label Content="Lenovo Tailscale _IP" Target="{Binding ElementName=RelayIp}" />
    <TextBox x:Name="RelayIp" MinHeight="26" Margin="0,0,0,8" />
    <Label Content="Gaming _desktop Tailscale IP" Target="{Binding ElementName=DesktopIp}" />
    <TextBox x:Name="DesktopIp" MinHeight="26" />
    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Height="30" Margin="0,0,8,0" />
      <Button Content="Save" IsDefault="True" MinWidth="80" Height="30" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>
